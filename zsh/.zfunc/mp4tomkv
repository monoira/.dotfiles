# remux a video into mkv without re-encoding
#
#   mp4tomkv <video_file>
#
# writes <name>.mkv next to the input file
mp4tomkv() {
  if (( $# != 1 )); then
    printf '%s\n' "usage: mp4tomkv <video_file>" >&2
    return 2
  fi

  VIDEO_NAME="$1" && ffmpeg -hide_banner -loglevel info -i "$VIDEO_NAME" -c copy "${VIDEO_NAME%.*}.mkv"
}
