[user]
	name = monoira
	email = monoira@users.noreply.github.com
[core]
  editor = code --wait

[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code --wait $MERGED

[init]
  defaultBranch = main
[fetch]
  prune = true
[push]
  autoSetupRemote = true
