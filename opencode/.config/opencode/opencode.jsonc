{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  "mcp": {
    "servers": {
      // for debugging
      // disabled by default, enable via /mcps in each session when needed
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "/usr/bin/chromium-browser",
        ],
        "disabled": true,
      },
      // automating UI flows
      // disabled by default, enable via /mcps in each session when needed
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--executable-path",
          "/usr/bin/chromium-browser",
        ],
        "disabled": true,
      },
    },
  },
}
