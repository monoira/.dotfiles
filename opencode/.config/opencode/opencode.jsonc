{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  "lsp": true,
  "policies": [
    // hide certain built-in skills from the model and @ mention list
    { "action": "skill.use", "resource": "report", "effect": "deny" },
    { "action": "skill.use", "resource": "browser", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      // FOR: QA, automating UI flows
      // disabled by default, enable via /mcps in each session when needed
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--executable-path",
          "/usr/bin/chromium-browser",
        ],
        "disabled": true,
      },
      // FOR: DevTools-level debugging (react bugs/re-renders, lighthouse, memory). NOT QA.
      // disabled by default, enable via /mcps in each session when needed
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "/usr/bin/chromium-browser",
          "--no-usage-statistics",
        ],
        "disabled": true,
      },
    },
  },
}
